<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net48;net8.0;net10.0;netstandard2.0;netstandard2.1</TargetFrameworks>
    <Description>Newtonsoft.Json converters for Gobln.Pager. Serializes and deserializes Page and PagedList objects, keeping a Page's index, size, and total item count intact across the wire.</Description>
    <PackageTags>Page, Pager, Paging, Pagination, Json</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gobln.Pager\Gobln.Pager.csproj" />
  </ItemGroup>

</Project>
