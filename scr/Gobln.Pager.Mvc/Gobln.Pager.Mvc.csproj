<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net48;net8.0;net10.0</TargetFrameworks>
    <Description>ASP.NET MVC and ASP.NET Core HTML helpers for Gobln.Pager. Renders any IPage, such as a Page or the current page of a PagedList, as ready-to-style pagination markup directly in Razor views.</Description>
    <PackageTags>Page, Pager, Paging, Pagination, Mvc</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'net48'">
    <Reference Include="System.Web" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net10.0'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gobln.Pager\Gobln.Pager.csproj" />
  </ItemGroup>

</Project>
